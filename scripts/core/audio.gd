extends Node
## Sfx — sound effects, ambience and music. Streams are loaded from
## res://assets/audio (generated by tools/gen_audio.py); anything missing is
## simply silent, so the game never depends on an audio file existing.

const DIR := "res://assets/audio/"
const BUSES := ["Music", "SFX", "Ambience"]
const POOL := 10

var _cache: Dictionary = {}
var _players: Array[AudioStreamPlayer] = []
var _next := 0
var _loops: Dictionary = {}
var _music: AudioStreamPlayer
var _music_name := ""
var _last_play: Dictionary = {}
var _silent := false             ## headless runs (tests, CI) have no audio device: play nothing
var _music_tween: Tween


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_silent = DisplayServer.get_name() == "headless"
	for b in BUSES:
		if AudioServer.get_bus_index(b) < 0:
			AudioServer.add_bus()
			var i := AudioServer.bus_count - 1
			AudioServer.set_bus_name(i, b)
			AudioServer.set_bus_send(i, "Master")
	for i in POOL:
		var p := AudioStreamPlayer.new()
		p.bus = "SFX"
		add_child(p)
		_players.append(p)
	_music = AudioStreamPlayer.new()
	_music.bus = "Music"
	add_child(_music)
	Bus.sfx.connect(play)


func silence() -> void:
	## Stop everything that is playing (called before the game quits, so the
	## audio thread has a moment to release its playbacks).
	_music_name = ""
	_exit_tree()


func _exit_tree() -> void:
	for p in _players:
		p.stop()
		p.stream = null
	for key in _loops:
		var lp: AudioStreamPlayer = _loops[key]
		lp.stop()
		lp.stream = null
	_loops.clear()
	if _music_tween != null:
		_music_tween.kill()
		_music_tween = null
	_music.stop()
	_music.stream = null
	_cache.clear()


func stream(name: String) -> AudioStream:
	if _cache.has(name):
		return _cache[name]
	var s: AudioStream = null
	for ext in [".wav", ".ogg"]:
		var path: String = DIR + name + ext
		if ResourceLoader.exists(path):
			s = load(path)
			break
	_cache[name] = s
	return s


func play(name: String, volume_db: float = 0.0, pitch_var: float = 0.04) -> void:
	if _silent:
		return
	var s := stream(name)
	if s == null:
		return
	# Avoid machine-gunning the same sample within a few frames.
	var now := Time.get_ticks_msec()
	if now - int(_last_play.get(name, -1000)) < 60:
		return
	_last_play[name] = now
	var p := _players[_next]
	_next = (_next + 1) % POOL
	p.stream = s
	p.volume_db = volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_var, pitch_var)
	p.play()


func loop(name: String, on: bool, volume_db: float = -8.0, bus: String = "Ambience") -> void:
	## Start or stop a named looping sound (the sample itself is authored to loop).
	if on:
		if _loops.has(name) or _silent:
			return
		var s := stream(name)
		if s == null:
			return
		var p := AudioStreamPlayer.new()
		p.bus = bus
		p.stream = s
		p.volume_db = -40.0
		add_child(p)
		p.play()
		p.finished.connect(p.play)
		create_tween().tween_property(p, "volume_db", volume_db, 0.5)
		_loops[name] = p
	elif _loops.has(name):
		var p: AudioStreamPlayer = _loops[name]
		_loops.erase(name)
		var tw := create_tween()
		tw.tween_property(p, "volume_db", -40.0, 0.4)
		tw.tween_callback(p.queue_free)


func stop_loops() -> void:
	for name in _loops.keys():
		loop(name, false)


func music(name: String, volume_db: float = -14.0) -> void:
	if name == _music_name or _silent:
		return
	_music_name = name
	var s := stream(name) if name != "" else null
	if _music_tween != null:
		_music_tween.kill()
	var tw := create_tween()
	_music_tween = tw
	if _music.playing:
		tw.tween_property(_music, "volume_db", -45.0, 0.6)
	tw.tween_callback(func():
		_music.stop()
		if s != null:
			_music.stream = s
			_music.volume_db = -45.0
			_music.play()
	)
	if s != null:
		tw.tween_property(_music, "volume_db", volume_db, 1.2)
	if not _music.finished.is_connected(_music.play):
		_music.finished.connect(_music.play)


func set_volume(bus: String, linear: float) -> void:
	var i := AudioServer.get_bus_index(bus)
	if i < 0:
		return
	AudioServer.set_bus_mute(i, linear <= 0.001)
	AudioServer.set_bus_volume_db(i, linear_to_db(maxf(linear, 0.001)))
