[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/event_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = "review_invite"
title = "Friday 15:30 - Your Weekly Performance Review"
kind = "mail"
from = "martin"
subject = "Friday 15:30 - Your Weekly Performance Review"
body = "{name},\n\nHR will join us. Attendance is not optional and cannot be rescheduled, delegated, looped or excused.\n\nWear a shirt.\n\nMartin"
choices = []
expire = {}
window = 90
schedule = [{"day": 3, "at": 600}]
