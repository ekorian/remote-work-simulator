[gd_resource type="Resource" script_class="EventDef" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/event_def.gd" id="1"]

[resource]
script = ExtResource("1")
id = "formal_warning"
title = "Formal warning"
kind = "mail"
from = "linda"
window = 60
once = true
subject = "FORMAL WARNING: Engagement Metrics"
body = "{name},\n\nYour manager has raised concerns about your 'visibility' and 'responsiveness'. This letter goes in your file.\n\nYou may acknowledge it or contest it under Policy 9.\n\nLinda"
choices = [
  {
    "t": "Sign the acknowledgment.",
    "a": "ack",
    "ok": {"susp": -2, "say": "Linda: Acknowledged. Let's see improvement."}
  },
  {
    "t": "Contest it: request the underlying data under Policy 9.",
    "a": "escalate",
    "p": 52,
    "tags": ["jargon"],
    "ok": {
      "susp": -9,
      "say": "Linda: The data request will take 6 to 8 weeks. The warning is suspended until then."
    },
    "ko": {"susp": 5, "say": "Linda: Policy 9 was repealed. By Policy 10."}
  }
]
expire = {"susp": 6, "say": "Linda: Unacknowledged. Noted in your file."}
schedule = []
