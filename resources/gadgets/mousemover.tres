  },
  {
    "price": 70,
    "reliability": 98.0,
    "heat": 5,
    "can": ["presence"],
    "text": "'Human jitter' patch: wobbly, believable movement. More reliable, less Heat."
  },
  {
    "price": 110,
    "reliability": 99.0,
    "heat": 3,
    "can": ["presence", "pass_scan"],
    "text": "Replays your own recorded mouse movements. Passes SynerWatch activity scans."
  }
